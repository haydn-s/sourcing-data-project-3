# Copy to .env and fill in: cp .env.example .env
# .env is gitignored. Never commit real values. Training loads it with
# python-dotenv, and Docker reads it with --env-file (one KEY=value per line).

# Google Cloud: the project that holds our Cloud Storage bucket. Credentials
# come from `gcloud auth application-default login` (README > Authenticate).
GOOGLE_CLOUD_PROJECT=climate-impact-pipeline

# Data sources: API keys, needed only to run the data pipeline (make ingest).
# config.yaml refers to each one as ${NAME}. Everyone gets their own free key;
# never share one in git or chat. Uncomment the ones your sources use.
#
# USDA NASS Quick Stats (bee colonies, crops). Request one at https://quickstats.nass.usda.gov/api
# NASS_API_KEY=
# NOAA Climate Data Online (weather stations). Request one at https://www.ncdc.noaa.gov/cdo-web/token
# NOAA_CDO_TOKEN=
# EIA Open Data (power plants, electricity). Register at https://www.eia.gov/opendata/register.php
# EIA_API_KEY=
# NASA Earthdata Login (GRACE ice mass, via PO.DAAC). Generate a token on your
# profile at https://urs.earthdata.nasa.gov. Tokens expire, so regenerate it when downloads fail.
# EARTHDATA_TOKEN=

# Weights & Biases: the API key from your W&B user settings, or run `wandb login`
# WANDB_API_KEY=
# Train without W&B: offline (log locally) or disabled (no logging)
# WANDB_MODE=disabled

# API: which model to serve. A local path or gs://climate-impact-pipeline-data/models/latest/model.joblib
MODEL_URI=models/latest/model.joblib

# Front-end: base URL of the API
API_URL=http://localhost:8080
